using namespace std;
using namespace chrono;

class GameOfLife {
private:
    int size;
    vector<vector<int>> grid;
    vector<vector<int>> nextGrid;

public:
    GameOfLife(int n, double density = 0.3) : size(n) {
        grid.resize(size, vector<int>(size, 0));
        nextGrid.resize(size, vector<int>(size, 0));

        random_device rd;
        mt19937 gen(rd());
        uniform_real_distribution<> dis(0.0, 1.0);

        for (int i = 0; i < size; i++) {
            for (int j = 0; j < size; j++) {
                grid[i][j] = (dis(gen) < density) ? 1 : 0;
            }
        }
    }

    int countNeighbors(int i, int j) const {
        int count = 0;
        for (int di = -1; di <= 1; di++) {
            for (int dj = -1; dj <= 1; dj++) {
                if (di == 0 && dj == 0) continue;
                int ni = (i + di + size) % size;
                int nj = (j + dj + size) % size;
                count += grid[ni][nj];
            }
        }
        return count;
    }

    double runBenchmark(int numThreads, int steps) {
        omp_set_num_threads(numThreads);

        auto start = high_resolution_clock::now();

        for (int s = 0; s < steps; s++) {
#pragma omp parallel for collapse(2)
            for (int i = 0; i < size; i++) {
                for (int j = 0; j < size; j++) {
                    int neighbors = 0;
                    for (int di = -1; di <= 1; di++) {
                        for (int dj = -1; dj <= 1; dj++) {
                            if (di == 0 && dj == 0) continue;
                            int ni = (i + di + size) % size;
                            int nj = (j + dj + size) % size;
                            neighbors += grid[ni][nj];
                        }
                    }
                    if (grid[i][j] == 1) {
                        nextGrid[i][j] = (neighbors == 2 || neighbors == 3) ? 1 : 0;
                    }
                    else {
                        nextGrid[i][j] = (neighbors == 3) ? 1 : 0;
                    }
                }
            }
            grid.swap(nextGrid);
        }

        auto end = high_resolution_clock::now();
        double totalTime = duration<double>(end - start).count();
        return totalTime / steps * 1000;
    }
};

